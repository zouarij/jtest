for (AssertionResult assertion : assertionResults) {
    def name = String.valueOf(assertion.getName())
    def msg  = String.valueOf(assertion.getFailureMessage())  // safe even if null

    if (assertion.isFailure()) {
        failedAssertions.add("FAIL : " + name + " : " + msg)
    } else {
        passedAssertions.add("PASS : " + name)
    }
}



if (assertionResults == null || assertionResults.isEmpty()) {
    failedAssertions.add("No assertions found.")
}
