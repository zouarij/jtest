def raw = vars.get('businessid')
if (raw == null) {
    log.error('businessid is null -> extractor failed')
} else {
    // remove normal + smart quotes and trim spaces
    def clean = raw.replaceAll('[\"«»“”]', '').trim()
    vars.put('businessid', clean)
    log.info("businessid raw=${raw} | clean=${clean}")
}
